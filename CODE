from flask import Flask, render_template, request, redirect, url_for

app = Flask(__name__)


@app.route("/")
def index():
    """Display the registration form."""
    return render_template("index.html", error=None, form={})


@app.route("/submit", methods=["POST"])
def submit():
    """Handle form submission and show the confirmation page."""
    name = request.form.get("name", "").strip()
    city = request.form.get("city", "").strip()
    phone = request.form.get("phone", "").strip()

    # Basic validation
    if not name or not city or not phone:
        return render_template("index.html", error="All fields are required.",
                               form=request.form)
    if not (phone.isdigit() and len(phone) == 10):
        return render_template("index.html",
                               error="Phone number must be exactly 10 digits.",
                               form=request.form)

    return render_template("confirmation.html", name=name, city=city, phone=phone)


# Redirect direct GET visits to /submit back to the form
@app.route("/submit", methods=["GET"])
def submit_get():
    return redirect(url_for("index"))


if __name__ == "__main__":
    app.run(debug=True)
